# Supabase server connection. Never expose the secret key in client-side code.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=sb_secret_replace-with-your-server-secret-key

# Legacy projects may use this instead of SUPABASE_SECRET_KEY:
# SUPABASE_SERVICE_ROLE_KEY=replace-with-your-legacy-service-role-key

# Private booking manager access.
ADMIN_EMAIL=host@example.com
ADMIN_PASSWORD=replace-with-a-strong-password
SESSION_SECRET=replace-with-at-least-32-random-characters
