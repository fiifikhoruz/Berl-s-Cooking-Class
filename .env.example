# Supabase server connection. Never expose the secret key in client-side code.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=sb_secret_replace-with-your-server-secret-key

# Legacy projects may use this instead of SUPABASE_SECRET_KEY:
# SUPABASE_SERVICE_ROLE_KEY=replace-with-your-legacy-service-role-key

# Private booking manager access.
ADMIN_EMAIL=host@example.com
ADMIN_PASSWORD=replace-with-a-strong-password
SESSION_SECRET=replace-with-at-least-32-random-characters

# Booking confirmations and notifications through Resend.
RESEND_API_KEY=re_replace-with-your-resend-api-key
BOOKING_FROM_EMAIL=Berl's Cooking Class <bookings@your-verified-domain.com>
BOOKING_NOTIFICATION_EMAILS=client@example.com,owner@example.com
SESSION_MEETING_URL=https://meet.google.com/replace-with-your-meeting-link
